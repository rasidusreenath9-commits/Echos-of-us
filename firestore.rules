rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (uid)
    // Fields:
    //   - uid: string (required)
    //   - username: string (required, unique)
    //   - displayName: string (required)
    //   - email: string (optional)
    //   - photoURL: string (optional)
    //   - lastActive: timestamp (optional)
    //   - status: string (optional, online/offline)
    //
    // Collection: usernames
    // Document ID: username
    // Fields:
    //   - uid: string (required)
    //
    // Collection: messages
    // Document ID: auto-generated
    // Fields:
    //   - senderId: string (required)
    //   - receiverId: string (required)
    //   - text: string (optional)
    //   - voiceUrl: string (optional)
    //   - stickerUrl: string (optional)
    //   - status: string (optional, sent/delivered/seen)
    //   - timestamp: timestamp (required)
    //
    // Collection: typing
    // Document ID: conversationId_userId
    // Fields:
    //   - conversationId: string (required)
    //   - userId: string (required)
    //   - isTyping: bool (required)
    //   - lastUpdate: timestamp (required)
    //
    // Collection: calls
    // Document ID: auto-generated
    // Fields:
    //   - callerId: string (required)
    //   - receiverId: string (required)
    //   - status: string (required, ringing/ongoing/ended/missed)
    //   - type: string (required, video/audio)
    //   - offer: map (optional)
    //   - answer: map (optional)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isParticipant(data) {
      return isAuthenticated() && data != null && 'participants' in data && request.auth.uid in data.participants;
    }

    function isCallParticipant(data) {
      return isAuthenticated() && data != null && 'participants' in data && request.auth.uid in data.participants;
    }

    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate string length
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "rasidusreenath9@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'username', 'displayName']) &&
             data.uid is string &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 30 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() < 100;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'receiverId', 'timestamp', 'participants']) &&
             data.senderId == request.auth.uid &&
             data.participants is list && data.participants.size() == 2 &&
             request.auth.uid in data.participants &&
             (
               ('text' in data && data.text is string && data.text.size() > 0 && data.text.size() < 5000) ||
               ('voiceUrl' in data && data.voiceUrl is string) ||
               ('stickerUrl' in data && data.stickerUrl is string)
             );
    }

    function isValidCall(data) {
      return data.keys().hasAll(['callerId', 'receiverId', 'status', 'type', 'participants']) &&
             data.participants is list && data.participants.size() == 2 &&
             request.auth.uid in data.participants &&
             data.status in ['ringing', 'ongoing', 'ended', 'missed'] &&
             data.type in ['video', 'audio'];
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && (!('role' in request.resource.data) || request.resource.data.role == 'user');
      allow update: if (isOwner(userId) && isValidUser(request.resource.data) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)) || isAdmin();
    }

    match /test/connection {
      allow read: if true;
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /messages/{messageId} {
      allow read: if isAuthenticated() && isParticipant(resource.data);
      allow create: if isAuthenticated() && isValidMessage(request.resource.data);
      allow update: if isAuthenticated() && isParticipant(resource.data) && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /typing/{typingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /calls/{callId} {
      allow read: if isAuthenticated() && isCallParticipant(resource.data);
      allow create: if isAuthenticated() && isValidCall(request.resource.data);
      allow update: if isAuthenticated() && isCallParticipant(resource.data) && isValidCall(request.resource.data);
      allow delete: if isAuthenticated() && isCallParticipant(resource.data);

      match /callerCandidates/{candidateId} {
        allow read, write: if isAuthenticated() && isCallParticipant(get(/databases/$(database)/documents/calls/$(callId)).data);
      }
      match /receiverCandidates/{candidateId} {
        allow read, write: if isAuthenticated() && isCallParticipant(get(/databases/$(database)/documents/calls/$(callId)).data);
      }
    }
  }
}